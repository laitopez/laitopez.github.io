---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { undefined } from "astro:schema";

const allPosts = Object.values(
  import.meta.glob("../../content/blog/*.md", { eager: true })
);
const tags = [
  ...new Set(
    allPosts
      .map((post: any) => post.frontmatter.tags)
      .flat()
      .filter((post: any) => post !== undefined)
      .sort()
  ),
];
console.log({ tags });
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: 720px;
      }
      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      ul li a {
        display: block;
        text-decoration: none;
      }
      .title {
        flex: 1;
        margin-left: 20px;
      }
      .title:hover {
        text-decoration: underline;
      }
      .date {
        color: rgb(var(--gray));
        color: white;
        min-width: 100px;
      }
      ul li a:hover h4,
      ul li a:hover .date {
        color: rgb(var(--accent));
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section>
        <ul>
          {
            tags.map((tag) => (
              <li>
                <p class="date" />
                <a href={`/tags/${tag}/`} class="title">
                  {tag}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
