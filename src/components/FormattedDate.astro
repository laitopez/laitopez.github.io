---
interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<style>
  .date {
    color: white;
    min-width: 100px;
    margin: 10px;
  }
</style>

<time class="date" datetime={date.toISOString()}>
  {
    date.toLocaleDateString("en-us", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  }
</time>
